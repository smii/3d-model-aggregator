
# Hide Gmail sync funcitonality 
HIDE_GMAIL_FEATURES=""
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Database — SQLite file for local dev; use a postgresql:// URL in production
# (see the provider note at the top of prisma/schema.prisma)
DATABASE_URL="file:./prisma/dev.db"

# AES-256 key for encrypting platform session cookies at rest
# Generate with: openssl rand -base64 32
COOKIE_ENCRYPTION_KEY=""

# Thingiverse REST API — create an app at https://www.thingiverse.com/developers
# and use its App Token
THINGIVERSE_APP_TOKEN=""

# Cults3D GraphQL API — generate a personal API key at
# https://cults3d.com/en/api/keys (username is your Cults3D login)
CULTS3D_USERNAME=""
CULTS3D_API_KEY=""

# MyMiniFactory API — create a key at
# https://www.myminifactory.com/settings/developer
MYMINIFACTORY_API_KEY=""
